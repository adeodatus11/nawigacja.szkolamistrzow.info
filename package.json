{
  "name": "nawigacja-szkolamistrzow-info",
  "version": "1.0.0",
  "description": "Interaktywny plan budynków i sal Zespołu Szkół Zawodowych nr 5 we Wrocławiu.",
  "private": true,
  "scripts": {
    "build": "esbuild app.js --bundle --format=iife --minify --outfile=bundle.js",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "start": "python3 -m http.server 8787",
    "preview": "node scripts/preview.mjs",
    "test": "npm run build && playwright test",
    "test:headed": "playwright test --headed"
  },
  "keywords": [
    "plan-szkoly",
    "nawigacja",
    "zsz5"
  ],
  "author": "Zespół Szkół Zawodowych nr 5 we Wrocławiu",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide": "^1.25.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1"
  }
}
